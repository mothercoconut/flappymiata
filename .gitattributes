# Normalise line endings so builds are identical on Windows and on Linux CI.
# Without this, core.autocrlf turns gradlew into CRLF and Linux runners fail
# with "bad interpreter: No such file or directory".
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Must stay LF — these are executed by a shell.
gradlew     text eol=lf
*.sh        text eol=lf

# Never touch these.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.jar      binary
*.keystore binary
*.ttf      binary
